# =============================================================================
# DATABASE
# =============================================================================
# Option A — Neon (free): https://console.neon.tech → Connect → Pooled + Direct strings
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Option B — Docker: docker compose up -d
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/whatsup?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/whatsup?schema=public"

# Option C — Mac Postgres (port 5432):
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/whatsup?schema=public"
# DIRECT_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/whatsup?schema=public"

# =============================================================================
# CORE / RUNTIME
# =============================================================================
# Set to "production" on live hosts. Controls WhatsApp real-vs-simulation fallback.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Public base URL the API is reachable at (used to build tracking + webhook links)
API_URL=http://localhost:4000/api/v1
# Frontend app URL (used to build feedback request links in automations)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AUTH / CRYPTO
# =============================================================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Encrypts OAuth / WhatsApp tokens at rest (openssl rand -base64 32).
# WARNING: rotating this orphans all previously encrypted tokens.
ENCRYPTION_KEY=
# Optional: separate secret for signing OAuth "state". Falls back to JWT_ACCESS_SECRET.
OAUTH_STATE_SECRET=
# Optional: error tracking. When set, 5xx errors are forwarded from the global
# exception filter's reportToMonitoring hook (wire up your Sentry SDK there).
SENTRY_DSN=

# =============================================================================
# AI — pick ONE provider
# =============================================================================
# AI — Ollama (local, no cloud key)
OLLAMA_MODE=on
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text

# AI — OpenAI (set OLLAMA_MODE=off and provide a key)
# Also enables DALL-E scene image generation in the reel render pipeline.
OPENAI_API_KEY=

# =============================================================================
# REEL RENDER PIPELINE (TTS + images + FFmpeg compile)
# Requires FFmpeg on PATH (included in the API Dockerfile). Without an
# ElevenLabs key, scenes render with silent audio; without OpenAI, scenes use
# their stored/placeholder images.
# =============================================================================
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# =============================================================================
# WHATSAPP (Meta Cloud API)
# =============================================================================
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Force simulation even if a token is present (useful for demos). true/false
WHATSAPP_SANDBOX_MODE=false
# Template name used by the "test WhatsApp" button in Settings
WHATSAPP_TEST_TEMPLATE=hello_world
# Public URL Meta calls for webhooks (ngrok locally, Render URL in prod)
PUBLIC_WEBHOOK_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev

# =============================================================================
# META / FACEBOOK / INSTAGRAM OAUTH
# =============================================================================
META_APP_ID=
# FACEBOOK_APP_ID is accepted as an alias for META_APP_ID
# FACEBOOK_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/meta/callback
# Optional Facebook Login "configuration id" (Meta Login for Business)
META_CONFIG_ID=
# Set true to also save the OAuth token as the WhatsApp access token when a phone ID is found
META_OAUTH_SYNC_WHATSAPP=false

# =============================================================================
# GOOGLE OAUTH / ADS
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Places API key — enables LIVE competitor discovery + Google review sync.
# Without it, those features return curated demo data (clearly logged).
GOOGLE_PLACES_API_KEY=

# Safety cap for ad-campaign creation (live money). Campaigns are created PAUSED
# and cannot exceed this daily budget (INR). Default 5000 if unset.
ADS_MAX_DAILY_BUDGET=5000

# =============================================================================
# SMS PROVIDER (campaigns + inbox SMS). Leave unset for mock/simulated sends.
# Auto-detected from credentials, or force with SMS_PROVIDER=twilio|msg91|mock
# =============================================================================
SMS_PROVIDER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# MSG91 (popular in India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4

# =============================================================================
# EMAIL PROVIDER (campaigns + inbox email). Leave unset for mock/simulated sends.
# Auto-detected from credentials, or force with EMAIL_PROVIDER=resend|sendgrid|mock
# =============================================================================
EMAIL_PROVIDER=
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
SENDGRID_API_KEY=

# =============================================================================
# MEDIA STORAGE (Supabase Storage)
# Without these, the media library silently returns mock local paths.
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=growth-media

# =============================================================================
# JOB QUEUE (campaigns + automations)
# =============================================================================
# Local: docker compose up -d redis
# Upstash: paste ONLY rediss://default:TOKEN@xxx.upstash.io:6379 (not redis-cli --tls -u ...)
# Leave empty to run campaigns inline (no queue, no retries).
REDIS_URL=redis://localhost:6379
