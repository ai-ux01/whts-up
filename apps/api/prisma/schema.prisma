generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  INTERESTED
  FOLLOW_UP
  CLOSED
}

enum MessageSender {
  CONTACT
  AGENT
  AI
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  TEMPLATE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum AutomationTrigger {
  NO_REPLY_24H
  SERVICE_COMPLETED
  NEGATIVE_FEEDBACK_DETECTED
  POSITIVE_REVIEW_RECEIVED
}

enum AutomationAction {
  SEND_MESSAGE
  SEND_FEEDBACK_REQUEST
  NOTIFY_ADMIN
}

model Workspace {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String          @unique
  status                WorkspaceStatus @default(ACTIVE)
  whatsappPhoneNumberId String?
  whatsappAccessToken   String?
  webhookVerifyToken    String?
  aiEnabled             Boolean  @default(false)
  aiSystemPrompt        String?
  businessName          String?
  businessType          String?
  metaAdsAccountId      String?

  metaPageId            String?
  googleAdsCustomerId   String?
  facebookPixelId       String?
  instagramUsername     String?
  defaultUtmSource      String?
  metaOAuthToken        String?
  metaOAuthExpiresAt    DateTime?
  metaConnectedAt       DateTime?
  metaBusinessId        String?
  googleOAuthAccessToken  String?
  googleOAuthRefreshToken String?
  googleOAuthExpiresAt    DateTime?
  googleConnectedAt       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users           User[]
  contacts        Contact[]
  conversations   Conversation[]
  leads           Lead[]
  campaigns       Campaign[]
  automationRules AutomationRule[]
  socialAccounts  SocialAccount[]
  socialPosts     SocialPost[]
  reelProjects    ReelProject[]
  mediaAssets     MediaAsset[]
  brandKit        BrandKit?
  contentIdeas    ContentIdea[]
  scheduledPosts  ScheduledPost[]
  researchReports ResearchReport[]
  feedbacks             Feedback[]
  reviewRequests        ReviewRequest[]
  googleReviews         GoogleReview[]
  reputationInsights    ReputationInsight[]
  competitors           Competitor[]
  improvementSuggestions ImprovementSuggestion[]
  marketInsights        MarketInsight[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(AGENT)
  workspaceId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]    @relation("AssignedLeads")
  messages      Message[] @relation("AgentMessages")

  @@index([workspaceId])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  phone       String
  name        String?
  leadSource  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  lead          Lead?
  reviewRequests ReviewRequest[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@index([workspaceId, leadSource])
}

model Conversation {
  id            String   @id @default(cuid())
  workspaceId   String
  contactId     String
  lastMessageAt DateTime @default(now())
  unreadCount   Int      @default(0)
  lastSender    MessageSender?
  automationFiredAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, lastMessageAt])
  @@index([contactId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  senderUserId   String?
  content        String
  type           MessageType   @default(TEXT)
  externalId     String?       @unique
  deliveryStatus String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation("AgentMessages", fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
}

model ProcessedWebhookEvent {
  wamid     String   @id
  createdAt DateTime @default(now())
}

model Lead {
  id                String     @id @default(cuid())
  workspaceId       String
  contactId         String     @unique
  status            LeadStatus @default(NEW)
  notes             String?
  assignedUserId    String?
  tags              String[]   @default([])
  lastInteractionAt DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation("AssignedLeads", fields: [assignedUserId], references: [id])

  @@index([workspaceId, status])
  @@index([assignedUserId])
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  templateName   String
  templateParams Json?
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([workspaceId, status])
}

model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  phone             String
  name              String?
  status            RecipientStatus @default(PENDING)
  error             String?
  externalMessageId String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([externalMessageId])
}

model AutomationRule {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  trigger     AutomationTrigger
  action      AutomationAction
  config      Json
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
}

model SocialAccount {
  id             String   @id @default(cuid())
  workspaceId    String
  platform       String   // e.g. 'FACEBOOK', 'INSTAGRAM'
  accountId      String
  accountName    String
  accessToken    String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     SocialPost[]

  @@unique([workspaceId, platform, accountId])
  @@index([workspaceId])
}

model SocialPost {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  caption         String
  hashtags        String[] @default([])
  mediaUrl        String?
  platforms       String[] @default([]) // e.g. ['instagram_reel', 'facebook_post']
  status          String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  scheduledAt     DateTime?
  publishedAt     DateTime?
  error           String?
  postId          String?  // Meta API post ID
  insights        Json?    // views, clicks, engagement metrics
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

model ReelProject {
  id                String   @id @default(cuid())
  workspaceId       String
  title             String
  niche             String
  offer             String?
  script            String?
  voiceVoiceId      String?
  audioUrl          String?
  videoUrl          String?
  status            String   @default("DRAFT") // DRAFT, GENERATING, COMPLETED, FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scenes    ReelScene[]

  @@index([workspaceId])
}

model ReelScene {
  id          String   @id @default(cuid())
  projectId   String
  sceneNumber Int
  text        String
  imagePrompt String?
  imageUrl    String?
  audioUrl    String?
  duration    Float    @default(5.0)
  transition  String?  @default("fade")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project ReelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  url         String
  type        String   // IMAGE, VIDEO, AUDIO
  size        Int?
  folder      String?  @default("General") // Reels, Stock, Campaigns, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, folder])
}

model BrandKit {
  id             String   @id @default(cuid())
  workspaceId    String   @unique
  logoUrl        String?
  primaryColor   String?  @default("#16a34a")
  secondaryColor String?  @default("#14532d")
  fontFamily     String?  @default("Inter")
  brandVoice     String?  @default("Professional") // Professional, Hinglish-Casual, Humorous, Energetic
  ctaTemplate    String?  @default("DM us 'START' to learn more!")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContentIdea {
  id          String   @id @default(cuid())
  workspaceId String
  topic       String
  hook        String
  niche       String
  body        String?
  cta         String?
  type        String   @default("REEL") // REEL, POST, CAROUSEL
  saved       Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type])
}

model ScheduledPost {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String
  scheduledAt DateTime
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  platform    String   // INSTAGRAM, FACEBOOK, BOTH
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scheduledAt])
}

model ResearchReport {
  id           String   @id @default(cuid())
  workspaceId  String
  topic        String
  niche        String
  viralHooks   Json     // List of viral hooks with power ratings
  competitors  Json     // Competitor gaps and weaknesses
  trends       Json     // Search queries and content angles
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Feedback {
  id                String   @id @default(cuid())
  workspaceId       String
  customerName      String
  phone             String
  email             String?
  rating            Int
  feedback          String?
  sentiment         String?  // POSITIVE, NEUTRAL, NEGATIVE
  complaintCategory String?  // e.g. "Staff Behavior", "Delivery Delay", "Product Quality"
  source            String   @default("WHATSAPP") // WHATSAPP, WIDGET
  createdAt         DateTime @default(now())

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, rating])
  @@index([workspaceId, sentiment])
}

model ReviewRequest {
  id          String   @id @default(cuid())
  workspaceId String
  customerId  String   // Points to Contact
  platform    String   @default("GOOGLE") // GOOGLE, etc.
  sentAt      DateTime @default(now())
  reviewed    Boolean  @default(false)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([customerId])
}

model GoogleReview {
  id          String    @id @default(cuid())
  workspaceId String
  author      String
  rating      Int
  reviewText  String?
  reviewDate  DateTime
  sentiment   String?   // POSITIVE, NEUTRAL, NEGATIVE
  aiSummary   String?
  replyText   String?   // Store AI-generated or custom reply
  repliedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, rating])
}

model ReputationInsight {
  id          String   @id @default(cuid())
  workspaceId String
  insight     String
  category    String   // e.g. "COMPLAINT_TREND", "POSITIVE_HIGHLIGHT", "CSAT_OVERVIEW"
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Competitor {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  category      String
  location      String
  averageRating Float    @default(0.0)
  totalReviews  Int      @default(0)
  source        String   @default("GOOGLE_MAPS")
  createdAt     DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviews       CompetitorReview[]

  @@index([workspaceId])
}

model CompetitorReview {
  id                String   @id @default(cuid())
  competitorId      String
  reviewerName      String
  rating            Int
  reviewText        String?
  sentiment         String?  // POSITIVE, NEUTRAL, NEGATIVE
  complaintCategory String?  // e.g. "Pricing", "Service Speed", "Quality"
  praiseCategory    String?  // e.g. "Customer Service", "Product Quality"
  reviewDate        DateTime

  competitor        Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
}

model ImprovementSuggestion {
  id            String   @id @default(cuid())
  businessId    String   // maps to Workspace.id
  suggestion    String
  priority      String   // HIGH, MEDIUM, LOW
  category      String   // e.g. "Pricing", "Customer Support", "Delivery Speed"
  impactScore   Int      @default(0) // 1 to 100
  createdAt     DateTime @default(now())

  workspace     Workspace @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MarketInsight {
  id            String   @id @default(cuid())
  workspaceId   String   // tenant isolation
  title         String
  description   String
  category      String   // e.g. "MARKET_GAP", "COMPETITOR_WEAKNESS"
  createdAt     DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

